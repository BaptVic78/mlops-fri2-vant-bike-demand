# Host environments and VCS metadata: the image builds its own .venv from uv.lock.
**/.venv/
.git/
.gitattributes

# Caches and bytecode at any depth (a bare "__pycache__/" only matches the root).
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Secrets and private files.
.env
.env.*
roster.txt
reports/*private*

# Local outputs regenerated by the pipeline (tracking/mlflow.db holds host paths).
artifacts/
tracking/

# Not used by the pipeline: local course copy, editor settings, lab reports and
# screenshots (reports/week-01-team.md and the metrics files stay: preflight and
# the history need them).
mlops-course/
.vscode/
.idea/
reports/lab3-evidence/
reports/images/
reports/lab-*.md
